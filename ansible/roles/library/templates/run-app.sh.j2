#!/usr/bin/env bash
# Templated start/stop control script for {{ app_name }} (macOS non-systemd)

APP_DIR="{{ app_directory }}"
JAR_FILE="$APP_DIR/{{ jar_dest_name }}"
PID_FILE="$APP_DIR/app.pid"
LOG_FILE="$APP_DIR/logs/app.log"
JAVA_BIN="/opt/homebrew/opt/openjdk@17/bin/java"

if [ ! -x "$JAVA_BIN" ]; then
    JAVA_BIN=$(which java)
fi

stop_app() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            echo "Stopping {{ app_name }} with PID $PID..."
            kill "$PID" || true
            sleep 3
            if ps -p "$PID" > /dev/null 2>&1; then
                kill -9 "$PID" || true
            fi
        fi
        rm -f "$PID_FILE"
    fi
}

start_app() {
    stop_app
    echo "Starting {{ app_name }}..."
    cd "$APP_DIR" || exit 1
    nohup "$JAVA_BIN" -jar "$JAR_FILE" > "$LOG_FILE" 2>&1 &
    NEW_PID=$!
    echo "$NEW_PID" > "$PID_FILE"
    echo "{{ app_name }} started with PID $NEW_PID"
}

case "$1" in
    start)
        start_app
        ;;
    stop)
        stop_app
        ;;
    restart)
        start_app
        ;;
    status)
        if [ -f "$PID_FILE" ] && ps -p "$(cat "$PID_FILE")" > /dev/null 2>&1; then
            echo "{{ app_name }} is running with PID $(cat "$PID_FILE")"
            exit 0
        else
            echo "{{ app_name }} is not running"
            exit 1
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac

